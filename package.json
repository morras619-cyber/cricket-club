{
  "name": "sixcharge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sixcharge: Superhero Cricket — mobile web vertical slice",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "test": "node --test tests/*.test.js",
    "smoke": "node tests/smoke.mjs",
    "opening": "node tests/opening.mjs",
    "trials": "node tests/trials.mjs",
    "android": "node tests/android.mjs",
    "build": "vite build",
    "android:sync": "vite build && cap sync android",
    "preview": "vite preview --port 8081"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
